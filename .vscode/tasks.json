{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-compose-up",
      "type": "shell",
      "command": "docker-compose up -d",
      "options": {
        "cwd": "${workspaceFolder}/scripts/setup/devcontainer"
      }
    },
    {
      "label": "setup-env",
      "type": "shell",
      "command": "./scripts/setupDevelopmentEnvironment.sh",
      "args": ["-s", "LOCAL", "-d", "H2"],
      "dependsOn": ["docker-compose-up"],
      "group": {
        "isDefault": true,
        "kind": "build"
      }
    },
    {
      "label": "setup-env2",
      "type": "shell",
      "command": "./scripts/setupDevelopmentEnvironment.sh",
      "args": ["-s", "MINIO", "-d", "POSTGRESQL"],
      "dependsOn": ["docker-compose-up"],
      "group": {
        "isDefault": true,
        "kind": "build"
      }
    },
    {
      "label": "setup-env-observability",
      "detail": "setup-env + start the local OpenTelemetry backend (Grafana on :3001)",
      "type": "shell",
      "command": "./scripts/setupDevelopmentEnvironment.sh",
      "args": ["-s", "LOCAL", "-d", "H2", "-o"],
      "dependsOn": ["docker-compose-up"],
      "group": { "kind": "build" }
    },
    {
      "label": "observability-up",
      "type": "shell",
      "command": "docker compose -f telemetry-compose/backend.yml up -d",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "observability-down",
      "type": "shell",
      "command": "docker compose -f telemetry-compose/backend.yml down",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "setup-env3",
      "type": "shell",
      "command": "./scripts/setupDevelopmentEnvironment.sh",
      "args": ["-s", "MINIO", "-d", "MSSQL"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "yarn-install",
      "type": "shell",
      "command": "if [ \"$USER\" = \"vscode\" ]; then echo \"Installing UI dependencies...\"; cd ui && export COREPACK_ENABLE_DOWNLOAD_PROMPT=0 && corepack enable && yarn install && cd ..; fi"
    }
  ]
}
