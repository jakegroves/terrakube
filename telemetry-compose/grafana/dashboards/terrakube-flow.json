{
  "__inputs": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["terrakube", "generic"],
  "title": "Terrakube - Flow Efficiency",
  "uid": "terrakube-flow",
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "label": "Metrics source", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0 },
      {
        "name": "organization", "label": "Organization", "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(terrakube_run_finished_total, organization)",
        "includeAll": true, "multi": true, "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }, "refresh": 2
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "p95 queue wait",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(terrakube_job_queue_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "refId": "A" } ]
    },
    {
      "id": 2, "type": "stat", "title": "p50 queue wait",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.5, sum by (le) (rate(terrakube_job_queue_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "refId": "A" } ]
    },
    {
      "id": 3, "type": "stat", "title": "p95 approval wait",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(terrakube_run_approval_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "refId": "A" } ]
    },
    {
      "id": 4, "type": "stat", "title": "p95 run duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(terrakube_run_duration_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "refId": "A" } ]
    },
    {
      "id": 5, "type": "gauge", "title": "Runs awaiting approval",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 } ] } }, "overrides": [] },
      "targets": [ { "expr": "sum(terrakube_run_awaiting_approval)", "refId": "A" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Queue wait percentiles",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(terrakube_job_queue_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.9, sum by (le) (rate(terrakube_job_queue_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(terrakube_job_queue_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Approval wait percentiles",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(terrakube_run_approval_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(terrakube_run_approval_wait_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Run duration p95 by plan_only",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, plan_only) (rate(terrakube_run_duration_seconds_bucket{organization=~\"$organization\"}[$__rate_interval])))", "legendFormat": "p95 plan_only={{plan_only}}", "refId": "A" } ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Approval funnel (per hour)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum(rate(terrakube_job_transitions_total{to=\"waitingApproval\"}[1h])) * 3600", "legendFormat": "entered approval", "refId": "A" },
        { "expr": "sum(rate(terrakube_run_finished_total{outcome=\"rejected\",organization=~\"$organization\"}[1h])) * 3600", "legendFormat": "rejected", "refId": "B" }
      ]
    },
    {
      "id": 10, "type": "table", "title": "Slowest orgs by p95 run duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "topk(10, histogram_quantile(0.95, sum by (le, organization) (rate(terrakube_run_duration_seconds_bucket[$__range]))))", "format": "table", "instant": true, "refId": "A" } ]
    }
  ]
}
